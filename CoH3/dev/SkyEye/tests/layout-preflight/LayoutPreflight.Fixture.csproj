<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LayoutSourceRoot Condition="'$(LayoutSourceRoot)' == ''">../../client/CoH3MemoryTool</LayoutSourceRoot>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Maintenance'">
    <DefineConstants>$(DefineConstants);MAINTENANCE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LayoutSourceRoot)/GameLayout52426.cs" Link="GameLayout52426.cs" />
  </ItemGroup>
</Project>
