<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>SkyEye.Maintenance.UI.Unverified</AssemblyName>
    <StartupObject>CoH3MemoryTool.ControlsProgram</StartupObject>
    <DefineConstants>$(DefineConstants);MAINTENANCE_DIAGNOSTICS</DefineConstants>
    <ClientRoot>../../client</ClientRoot>
    <GeneratedSourceRoot>$(MSBuildProjectDirectory)/obj/maintenance-ui-generated</GeneratedSourceRoot>
    <ApplicationManifest>$(ClientRoot)/app.manifest</ApplicationManifest>
    <AppConfig>$(ClientRoot)/app.config</AppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ClientRoot)/**/*.cs" Exclude="$(ClientRoot)/CoH3MemoryTool/*Checks*.cs;$(ClientRoot)/obj/**/*.cs;$(ClientRoot)/bin/**/*.cs;$(ClientRoot)/CoH3MemoryTool/OverlaySettingsForm.cs;$(ClientRoot)/CoH3MemoryTool/SquadMarkerWindow.cs;$(ClientRoot)/CoH3MemoryTool/AirOverlayWindow.cs" Link="Engine/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(GeneratedSourceRoot)/OverlaySettingsForm.cs" Link="MaintenanceGenerated/OverlaySettingsForm.cs" />
    <Compile Include="$(GeneratedSourceRoot)/SquadMarkerWindow.cs" Link="MaintenanceGenerated/SquadMarkerWindow.cs" />
    <Compile Include="$(GeneratedSourceRoot)/AirOverlayWindow.cs" Link="MaintenanceGenerated/AirOverlayWindow.cs" />
    <EmbeddedResource Include="$(ClientRoot)/CoH3.InterfaceIcon" LogicalName="CoH3.InterfaceIcon" />
    <EmbeddedResource Include="$(ClientRoot)/names-zh-hans.tsv" LogicalName="names-zh-hans.tsv" />
    <EmbeddedResource Include="$(ClientRoot)/CoH3.BarrageCatalogue.tsv" LogicalName="CoH3.BarrageCatalogue.tsv" />
    <EmbeddedResource Include="$(ClientRoot)/CoH3.Audio.NAudio.dll" LogicalName="CoH3.Audio.NAudio.dll" />
    <None Include="$(ClientRoot)/sounds/**/*.mp3" Link="sounds/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Core" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="NAudio"><HintPath>$(ClientRoot)/CoH3.Audio.NAudio.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyOriginalMaintenanceUiConfig" AfterTargets="Build">
    <Copy SourceFiles="$(ClientRoot)/app.config" DestinationFiles="$(TargetPath).config" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="GenerateMaintenanceUiSources" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/GenerateSources.ps1&quot;" />
  </Target>
</Project>
