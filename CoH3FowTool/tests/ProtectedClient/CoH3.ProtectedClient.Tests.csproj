<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately reference the already-obfuscated DLL, never a project build. -->
    <Reference Include="Licensing.Client">
      <HintPath>$(ProtectedClientAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireProtectedInput" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ProtectedClientAssembly)' == '' or !Exists('$(ProtectedClientAssembly)')"
           Text="Pass -p:ProtectedClientAssembly with the actual protected licensing DLL." />
  </Target>
</Project>
