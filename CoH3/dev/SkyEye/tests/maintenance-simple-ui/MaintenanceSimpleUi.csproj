<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>COH3SimpleTool.Maintenance.UI.Unverified</AssemblyName>
    <StartupObject>CoH3MemoryTool.SimpleProgram</StartupObject>
    <DefineConstants>$(DefineConstants);MAINTENANCE_DIAGNOSTICS</DefineConstants>
    <ClientRoot>../../../COH3SimpleTool</ClientRoot>
    <GeneratedSourceRoot>$(MSBuildProjectDirectory)/obj/maintenance-simple-ui-generated</GeneratedSourceRoot>
    <ApplicationIcon>$(ClientRoot)/app.ico</ApplicationIcon>
    <ApplicationManifest>$(ClientRoot)/app.manifest</ApplicationManifest>
    <AppConfig>$(ClientRoot)/app.config</AppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ClientRoot)/**/*.cs" Exclude="$(ClientRoot)/CoH3MemoryTool/*Checks*.cs;$(ClientRoot)/obj/**/*.cs;$(ClientRoot)/bin/**/*.cs;$(ClientRoot)/CoH3MemoryTool/ControlBarForm.cs;$(ClientRoot)/CoH3MemoryTool/SquadMarkerWindow.cs;$(ClientRoot)/CoH3MemoryTool/AirOverlayWindow.cs" Link="Engine/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(GeneratedSourceRoot)/ControlBarForm.cs" Link="MaintenanceGenerated/ControlBarForm.cs" />
    <Compile Include="$(GeneratedSourceRoot)/SquadMarkerWindow.cs" Link="MaintenanceGenerated/SquadMarkerWindow.cs" />
    <Compile Include="$(GeneratedSourceRoot)/AirOverlayWindow.cs" Link="MaintenanceGenerated/AirOverlayWindow.cs" />
    <EmbeddedResource Include="$(ClientRoot)/CoH3.InterfaceIcon" LogicalName="CoH3.InterfaceIcon" />
    <EmbeddedResource Include="$(ClientRoot)/names-zh-hans.tsv" LogicalName="names-zh-hans.tsv" />
    <EmbeddedResource Include="$(ClientRoot)/CoH3.BarrageCatalogue.tsv" LogicalName="CoH3.BarrageCatalogue.tsv" />
    <Reference Include="System.Core" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="CopyOriginalMaintenanceSimpleUiConfig" AfterTargets="Build">
    <Copy SourceFiles="$(ClientRoot)/app.config" DestinationFiles="$(TargetPath).config" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="GenerateMaintenanceSimpleUiSources" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/GenerateSources.ps1&quot;" />
  </Target>
</Project>
